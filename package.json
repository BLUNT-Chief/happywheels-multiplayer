{
  "name": "happywheels-multiplayer",
  "productName": "Happy Wheels Multiplayer",
  "version": "0.1.5",
  "description": "Unofficial multiplayer racing mod for Happy Wheels on Steam",
  "main": "src/main/index.js",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Happy Wheels Multiplayer contributors"
  },
  "scripts": {
    "build:renderer": "node scripts/build-renderer.js",
    "start": "node scripts/build-renderer.js && electron .",
    "dev": "node scripts/build-renderer.js && electron . --hwmp-dev",
    "icon": "electron scripts/make-icon.js",
    "dist": "node scripts/build-renderer.js --prod && electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "io.github.hwmp.happywheelsmultiplayer",
    "productName": "Happy Wheels Multiplayer",
    "copyright": "Unofficial fan-made mod. Happy Wheels is a trademark of Fancy Force; this project is not affiliated with them.",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "src/main/**",
      "!src/main/devBridge.js",
      "!src/main/localNet.js",
      "src/preload/**",
      "src/launcher/**",
      "out/web/**"
    ],
    "asar": true,
    "electronLanguages": [
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "HappyWheelsMultiplayer-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "license": "build/installer-license.txt",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Happy Wheels Multiplayer",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true,
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "BLUNT-Chief",
        "repo": "happywheels-multiplayer",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BLUNT-Chief/happywheels-multiplayer.git"
  },
  "homepage": "https://github.com/BLUNT-Chief/happywheels-multiplayer"
}
